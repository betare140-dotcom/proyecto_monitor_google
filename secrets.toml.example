# Copia este archivo como .streamlit/secrets.toml y reemplaza los valores.
# No subas secrets.toml ni credenciales JSON al repositorio.

GEMINI_API_KEY = "TU_API_KEY_DE_GEMINI"

[google_oauth]
client_id = "000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
# Debe coincidir exactamente con la URI autorizada en Google Cloud.
redirect_uri = "https://TU-APLICACION.streamlit.app"
# Para una prueba local temporal usa: http://localhost:8501
